---
import Base from '../layouts/Base.astro';
import Crest from '../components/Crest.astro';
import Tartan from '../components/Tartan.astro';
import Headshot from '../components/Headshot.astro';
import { loadSite, playerStats } from '../lib/site';
import { href, photo } from '../lib/paths';
import { images, motto, established } from '../config';

const site = loadSite();
const years = site.years;
const latest = years[years.length - 1]!;
const venueCount = new Set(years.map((y) => y.venue)).size;

const winnerName = (slug: string | undefined) => (slug ? site.players[slug]!.name : null);
const latestTop = latest.leaderboard?.[0]?.totalPoints ?? null;

// Player preview: current-year field, ranked by this year's leaderboard position.
const positionBySlug = new Map(latest.leaderboard?.map((e) => [e.slug, e.position]) ?? []);
const preview = latest.participants
  .map((slug) => ({ slug, player: site.players[slug]!, stats: playerStats(site, slug) }))
  .sort((a, b) => (positionBySlug.get(a.slug) ?? Infinity) - (positionBySlug.get(b.slug) ?? Infinity))
  .slice(0, 5);

const romanYear = (n: number) => {
  const numerals: [number, string][] = [[1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'], [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
  let out = '';
  for (const [value, glyph] of numerals) while (n >= value) { out += glyph; n -= value; }
  return out;
};
---

<Base title="The Ruthven Cup" heroNav>
  <header class="hero">
    <div class="est label"><span>Est. {romanYear(established)} · Scotland</span></div>
    <div class="crest-slot"><Crest size={96} /></div>
    <h1>
      <span class="line"><span>The Ruthven</span></span>
      <span class="line"><span><em>Cup</em></span></span>
    </h1>
    <div class="motto">“{motto}”</div>
    <div class="cta">
      <a class="btn solid" href={href(`/${latest.year}/`)}>This year — {latest.year}</a>
      <a class="btn ghost" href={href('/players/')}>The players</a>
    </div>
    <div class="scroll-cue">Scroll</div>
  </header>

  <Tartan />

  <div class="marquee" aria-hidden="true">
    <div class="track">
      {
        [0, 1].map(() => (
          <>
            <span>“{motto}”</span>
            <b>EST. {established}</b>
            <span>{years.length} years, {venueCount} venues</span>
            <b>ONE CUP</b>
            <span>Engraved annually</span>
            <b>SCOTLAND</b>
            <span>Excuse for a massive piss up</span>
            <b>{latest.participants.length} PLAYERS IN {latest.year}</b>
            <span>one little golden penis</span>
            <b>YOU CAN'T CHOOSE FAMILY</b>
          </>
        ))
      }
    </div>
  </div>

  <section class="honours" id="honours">
    <div class="measure">
      <div class="label reveal">The Honours Board</div>
      <h2 class="display reveal">{years.length} years,<br />etched into <em>Ruthven</em> history.</h2>
      {
        [...years].reverse().map((y) => (
          <a class="row reveal" href={href(`/${y.year}/`)}>
            {y.courseData?.photo && (
              <img class="row-venue-photo" src={photo(`courses/${y.courseData.photo}`)} alt="" aria-hidden="true" />
            )}
            <div class="year">{y.year}</div>
            <div class="who">
              {winnerName(y.tankard?.winner) ?? '— to be engraved —'}
              {y.year === established && <i>the inaugural champion</i>}
              {y.year === latest.year && <i>the reigning champion</i>}
              {y.tankard?.decidedByPuttOff && <i>won on the midget putter</i>}
            </div>
            <div class="where">{y.venue}</div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="stats">
    <div class="measure">
      <div class="stat reveal"><div class="n" data-count={years.length}>0</div><span class="label">Years contested</span></div>
      <div class="stat reveal"><div class="n" data-count={latest.participants.length}>0</div><span class="label">Players in {latest.year}</span></div>
      {
        latestTop !== null && (
          <div class="stat reveal">
            <div class="n" data-count={latestTop}><span>0</span><sup>pts</sup></div>
            <span class="label">Winning Stableford</span>
          </div>
        )
      }
    </div>
  </section>

  <section class="players" id="players">
    <div class="measure">
      <div class="label reveal">The Field — {latest.year}</div>
      <h2 class="display reveal">Family, friends,<br />and <em>rivals.</em></h2>
      <p class="lede reveal">This year's line-up. See the full roster for everyone who's ever teed it up.</p>
      <div class="grid">
        {
          preview.map(({ slug, player, stats }) => {
            const wins = stats.tankardWins.length + stats.phallusWins.length;
            return (
              <a class:list={['player', 'reveal', { champ: wins > 0 }]} href={href(`/players/${slug}/`)}>
                <div class="ph"><Headshot player={player} /></div>
                <div class="meta">
                  <span class="name">{player.name}</span>
                  <span class="tag">
                    {wins > 0 ? `${wins}× champion · ` : ''}
                    {player.family ? 'Family' : 'Guest'} · Since {player.since}
                  </span>
                </div>
              </a>
            );
          })
        }
      </div>
      <div class="all-link reveal"><a href={href('/players/')}>All players &amp; bios →</a></div>
    </div>
  </section>

  <section class="trophies" id="trophies">
    <div class="measure">
      <div class="label reveal">The Trophies</div>
      <h2 class="display reveal">Two prizes,<br />one <em>Cup</em>, one very sore <em>arse.</em></h2>
      <div class="trophy-grid">
      <div class="trophy reveal">
        {
          images.tankard ? (
            <img class="trophy-img" src={photo(images.tankard)} alt="The Ruthven Cup Tankard" />
          ) : (
            <div class="placeholder-box plinth">Tankard photo</div>
          )
        }
        <h3>The <em>Tankard</em></h3>
        <p>The Ruthven families prestigous Cup. Engraved each year with the winner's name, next year Nicholas, next year...</p>
      </div>
      <div class="trophy reveal">
        {
          images.phallus ? (
            <img class="trophy-img" src={photo(images.phallus)} alt="The Phallus Trophy" />
          ) : (
            <div class="placeholder-box plinth">Trophy photo</div>
          )
        }
        <h3>The <em>Phallus Trophy</em></h3>
        <p>The best of the rest. “The big one” Coveted, feared, seen more action that Elton John's dildo. Ensure bleached and microwaved for
          30 minutes before receiving
        </p>
      </div>
      </div>
    </div>
  </section>

  <script>
    // Count-up stats when they scroll into view.
    const cio = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          cio.unobserve(entry.target);
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.count);
          const node = el.querySelector('span') ?? el;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            node.textContent = String(target);
            continue;
          }
          const t0 = performance.now();
          const duration = 1400;
          const tick = (t: number) => {
            const p = Math.min((t - t0) / duration, 1);
            node.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));
  </script>

  <style>
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      position: relative;
      padding: 120px 24px 80px;
      background:
        radial-gradient(ellipse 80% 50% at 50% -10%, rgba(201, 166, 90, 0.14), transparent 70%),
        radial-gradient(ellipse 60% 40% at 50% 110%, rgba(140, 38, 50, 0.08), transparent 70%);
    }
    .est {
      overflow: hidden;
    }
    .est span {
      display: inline-block;
      animation: riseUp 1s 0.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .crest-slot {
      margin-top: 26px;
      animation: fadeIn 1.4s 0.7s both;
    }
    h1 {
      margin-top: 24px;
      font-weight: 300;
      font-size: clamp(64px, 12vw, 168px);
      line-height: 0.92;
      letter-spacing: -0.015em;
      color: var(--ink);
    }
    h1 .line {
      display: block;
      overflow: hidden;
    }
    h1 .line > span {
      display: inline-block;
      animation: riseUp 1.3s cubic-bezier(0.16, 0.8, 0.24, 1) both;
    }
    h1 .line:nth-child(1) > span {
      animation-delay: 0.35s;
    }
    h1 .line:nth-child(2) > span {
      animation-delay: 0.5s;
    }
    h1 em {
      font-style: italic;
      font-weight: 300;
      background: linear-gradient(100deg, var(--gold) 20%, var(--gold-bright) 40%, #f6e7bd 50%, var(--gold-bright) 60%, var(--gold) 80%);
      background-size: 200% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      animation: shimmer 5s linear 1.8s infinite;
    }
    @keyframes shimmer {
      to {
        background-position: -200% 0;
      }
    }
    @keyframes riseUp {
      from {
        opacity: 0;
        transform: translateY(110%);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    .motto {
      margin-top: 32px;
      font-style: italic;
      font-size: clamp(15px, 2vw, 20px);
      color: var(--gold);
      animation: fadeIn 1.4s 1.15s both;
    }
    .cta {
      margin-top: 30px;
      display: flex;
      gap: 12px;
      animation: fadeIn 1.4s 1.4s both;
    }
    .scroll-cue {
      position: absolute;
      bottom: 36px;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--sans);
      font-size: 9px;
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--gold);
      animation: fadeIn 1s 2s both;
    }
    .scroll-cue::after {
      content: '';
      display: block;
      width: 1px;
      height: 44px;
      margin: 12px auto 0;
      background: linear-gradient(var(--gold), transparent);
      animation: drip 2.2s ease-in-out infinite;
      transform-origin: top;
    }
    @keyframes drip {
      0% {
        transform: scaleY(0);
      }
      45% {
        transform: scaleY(1);
      }
      100% {
        transform: scaleY(0);
        transform-origin: bottom;
      }
    }

    .marquee {
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
      overflow: hidden;
      white-space: nowrap;
      padding: 16px 0;
      background: var(--paper-2);
    }
    .marquee .track {
      display: inline-block;
      animation: marquee 28s linear infinite;
    }
    .marquee span {
      font-size: 15px;
      font-style: italic;
      color: var(--gold);
      opacity: 0.85;
      margin: 0 28px;
    }
    .marquee b {
      font-family: var(--sans);
      font-style: normal;
      font-weight: 500;
      font-size: 10px;
      letter-spacing: 0.34em;
      color: var(--ink);
      opacity: 0.55;
      vertical-align: 2px;
    }
    @keyframes marquee {
      to {
        transform: translateX(-50%);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee .track {
        animation: none;
      }
    }

    .row {
      position: relative;
      display: grid;
      grid-template-columns: 180px 1fr auto;
      align-items: baseline;
      gap: 24px;
      padding: 34px 8px;
      border-top: 1px solid var(--hairline);
      text-decoration: none;
      transition: background 0.4s, padding-left 0.4s;
      overflow: hidden;
    }
    .row:last-child {
      border-bottom: 1px solid var(--hairline);
    }
    .row-venue-photo {
      position: absolute;
      inset: 0;
      left: auto;
      width: 55%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
      pointer-events: none;
      filter: grayscale(0.3) saturate(0.8) brightness(0.6);
      mask-image: linear-gradient(to left, black 0%, transparent 80%);
      -webkit-mask-image: linear-gradient(to left, black 0%, transparent 80%);
    }
    .row:hover {
      background: rgba(201, 166, 90, 0.05);
      padding-left: 20px;
    }
    .row .year {
      font-size: clamp(36px, 4.5vw, 60px);
      font-weight: 300;
      color: transparent;
      -webkit-text-stroke: 1px var(--gold);
      transition: color 0.4s;
    }
    .row:hover .year {
      color: var(--gold);
    }
    .row .who {
      font-size: clamp(20px, 2.4vw, 30px);
      font-weight: 300;
    }
    .row .who i {
      display: block;
      font-size: 14px;
      color: var(--gold);
      margin-top: 6px;
    }
    .row .where {
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      opacity: 0.55;
      justify-self: end;
    }

    .stats {
      background: var(--paper-2);
      border-top: 1px solid var(--hairline);
      border-bottom: 1px solid var(--hairline);
    }
    .stats .measure {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 48px;
      text-align: center;
    }
    .stat .n {
      font-size: clamp(56px, 8vw, 110px);
      font-weight: 300;
      color: var(--gold);
      line-height: 1;
      font-variant-numeric: lining-nums tabular-nums;
    }
    .stat .n sup {
      font-size: 0.35em;
      color: var(--ink);
      opacity: 0.6;
    }
    .stat .label {
      margin-top: 14px;
      display: block;
      color: var(--ink);
      opacity: 0.6;
    }

    .players .lede {
      font-size: 18px;
      font-weight: 300;
      opacity: 0.75;
      max-width: 520px;
      margin: -26px 0 56px;
      font-style: italic;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 2px;
    }
    .player {
      aspect-ratio: 3 / 4;
      position: relative;
      overflow: hidden;
      background: #103021;
      display: flex;
      align-items: flex-end;
      text-decoration: none;
      transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .player:hover {
      transform: scale(0.97);
    }
    .player .ph {
      position: absolute;
      inset: 0;
      transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .player:hover .ph {
      transform: scale(1.08);
    }
    .player .meta {
      position: relative;
      z-index: 2;
      width: 100%;
      padding: 16px;
      background: linear-gradient(transparent, rgba(6, 18, 12, 0.92) 55%);
    }
    .player .meta .name {
      font-size: 19px;
      font-weight: 400;
      display: block;
    }
    .player .meta .tag {
      font-family: var(--sans);
      font-size: 8px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--gold);
      display: block;
      margin-top: 5px;
    }
    .player.champ::before {
      content: '★';
      position: absolute;
      top: 2px;
      right: 4px;
      width: 34px;
      height: 34px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold-bright);
      z-index: 3;
      font-size: 14px;
    }
    .all-link {
      margin-top: 24px;
    }
    .all-link a {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--gold);
      text-decoration: none;
    }
    .all-link a:hover {
      color: var(--gold-bright);
    }

    .trophies {
      padding-top: 0;
    }
    .trophy-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      margin-top: 56px;
    }
    .trophy {
      padding: 72px 48px;
      text-align: center;
      border: 1px solid var(--hairline);
      background: linear-gradient(180deg, rgba(201, 166, 90, 0.04), transparent);
      transition: background 0.5s;
    }
    .trophy:hover {
      background: rgba(201, 166, 90, 0.07);
    }
    .plinth {
      width: 96px;
      height: 118px;
      margin: 0 auto 30px;
      animation: float 5s ease-in-out infinite;
    }
    .trophy-img {
      max-height: 200px;
      width: auto;
      margin: 0 auto 30px;
      animation: float 5s ease-in-out infinite;
    }
    .trophy:nth-child(2) .plinth {
      animation-delay: 2.5s;
    }
    .trophy:nth-child(2) .trophy-img {
      animation: bounce 5s ease-in-out infinite;
    }
    @keyframes float {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-8px);
      }
    }
    @keyframes bounce {
      0% {
        transform: rotate(0deg) translateY(0);
      }
      19% {
        transform: rotate(0deg) translateY(-16px);
      }
      38% {
        transform: rotate(0deg) translateY(0);
      }
      57% {
        transform: rotate(0deg) translateY(-16px);
      }
      65% {
        transform: rotate(45deg) translateY(-16px);
      }
      69% {
        transform: rotate(45deg) translateY(-36px);
      }
      73% {
        transform: rotate(45deg) translateY(-16px);
      }
      77% {
        transform: rotate(45deg) translateY(-36px);
      }
      81% {
        transform: rotate(45deg) translateY(-16px);
      }
      85% {
        transform: rotate(45deg) translateY(-36px);
      }
      89% {
        transform: rotate(45deg) translateY(-16px);
      }
      100% {
        transform: rotate(0deg) translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .trophy-img,
      .plinth {
        animation: none;
      }
    }
    .trophy h3 {
      font-size: 32px;
      font-weight: 300;
      margin-bottom: 10px;
    }
    .trophy h3 em {
      font-style: italic;
      color: var(--gold);
    }
    .trophy p {
      font-size: 15px;
      font-style: italic;
      opacity: 0.65;
      max-width: 320px;
      margin: 0 auto;
    }

    @media (max-width: 760px) {
      .stats .measure {
        grid-template-columns: 1fr;
        gap: 36px;
      }
      .trophy-grid {
        grid-template-columns: 1fr;
      }
      .row {
        grid-template-columns: 90px 1fr;
      }
      .row .where {
        justify-self: start;
        grid-column: 2;
      }
      .cta {
        flex-direction: column;
      }
    }
  </style>
</Base>
